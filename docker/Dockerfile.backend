# ===== Stage 1: Build =====
FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies first (leveraging cache)
COPY package.json package-lock.json* ./
RUN npm ci --ignore-scripts

# Copy source files
COPY tsconfig.json ./
COPY src/ ./src/

# Build the TypeScript server
RUN npx tsc --project tsconfig.json --outDir dist

# ===== Stage 2: Run =====
FROM node:20-alpine AS runner

WORKDIR /app

# Install production dependencies only
COPY package.json package-lock.json* ./
RUN npm ci --production --ignore-scripts

# Copy server source and build output
COPY src/server/ ./src/server/
COPY tsconfig.json ./

# Copy data directory for SQLite persistence
RUN mkdir -p /app/data

EXPOSE 5000

# Set environment variables
ENV NODE_ENV=production
ENV PORT=5000
ENV DB_PATH=/app/data/kanban.db

# Start the server using tsx (runs TypeScript directly)
CMD ["npx", "tsx", "src/server/index.ts"]
